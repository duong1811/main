               <span>Select Video files to upload</span>
               <input type="file" id="fileMenuEN" accept="application/pdf" class="file" name="file"
                  onchange="File_image(this)">
            </label>
            <input type="text" name="folder" class="d-none" value="menuEN">
            <button type="submit" class="btn btn-success my-2 upload" disabled>Update</button>
            <div class="btn btn-secondary my-2 cancel">Cancel</div>
         </form>
      </div>
      <div class="menu-CZ">
         <div>
            <a href="" id="launchmenuCZ" target="_black">menuCZ</a>
         </div>
         <form onsubmit="updateMenu(event)" folder="launchmenuCZ" class="" id="up-home" enctype="multipart/form-data">
            <label htmlfor="fileMenuCZ"
               class="carousel mt-2 col-12 col-sm-6 col-md-4 rounded-3 border text-center border-secondary py-2"
               style="cursor: pointer">
               <span>Select Video files to upload</span>
               <input type="file" id="fileMenuCZ" accept="application/pdf" class="file" name="file"
                  onchange="File_image(this)">
            </label>
            <input type="text" name="folder" class="d-none" value="menuCZ">
            <button type="submit" class="btn btn-success my-2 upload" disabled>Update</button>
            <div class="btn btn-secondary my-2 cancel">Cancel</div>
         </form>
      </div>
      </div>
      <div class="text-info mt-4">
         <h3 class="fw-bold">
            Gallery
         </h3>
      </div>
      <div id="list-gallery" class="row"></div>
      <form onsubmit="upload(event)" class="" id="up-home" enctype="multipart/form-data">
         <label htmlfor="fileGallery"
            class="carousel mt-2 col-12 col-lg-4 rounded-3 border text-center border-secondary py-2"
            style="cursor: pointer">
            <span>Select Video files to upload</span>
            <input type="file" id="fileGallery" multiple="multiple" accept="image/*" name="files"
               onchange="File_image(this)">
         </label>
         <input type="text" id="folderInput" name="folder" class="d-none" value="gallery">
         <button type="submit" class="btn btn-success my-2 upload" disabled>Upload File</button>
         <div class="btn btn-secondary my-2 cancel">Cancel</div>
      </form>
      <div class="text-info">
         <h3>Review</h3>
      </div>
      <div id="review" class="row">
         <% if (reviews && reviews.length> 0) { %>
            <% reviews.forEach(review=> { %>
               <div class="col-md-6 mb-3">
                  <form class="card p-3 shadow-sm h-100 review-form" data-id="<%= review.id %>">
                     <div class="mb-2">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" value="<%= review.name %>" required>
                     </div>
                     <div class="mb-2">
                        <label class="form-label">Rating</label>
                        <select name="rating" class="form-select" required>
                           <% for(let i=5; i>=1; i--) { %>
                              <option value="<%= i %>" <%=review.rating==i ? 'selected' : '' %>><%= '★' .repeat(i) %>
                              </option>
                              <% } %>
                        </select>
                     </div>
                     <div class="mb-2">
                        <label class="form-label">Review (CZ)</label>
                        <textarea name="reviewCZ" class="form-control" rows="2"><%= review.reviewCZ || '' %></textarea>
                     </div>
                     <div class="mb-2">
                        <label class="form-label">Review (EN)</label>
                        <textarea name="reviewEN" class="form-control" rows="2"><%= review.reviewEN || '' %></textarea>
                     </div>
                     <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                     <div class="form-msg mt-2"></div>
                  </form>
               </div>
               <% }) %>
                  <% } else { %>
                     <p class="text-muted">No reviews yet.</p>
                     <% } %>
      </div>
   </section>
