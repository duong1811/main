   <style>
      .img-gallery {
         background-size: cover;
         background-repeat: no-repeat;
         background-position: center center;
         background-color: #f0f0f0;
         height: 20vh;
      }

      #list-gallery .img-gallery {
         background-position: center 63%;
      }

      input[type="file"] {
         position: absolute;
         left: 0;
         width: 100%;
         height: 100%;
         top: 0;
         opacity: 0;
         display: inline;
      }

      #box-delete {
         background: rgba(10, 10, 10, .86);
         position: fixed;
         width: 100vw;
         height: 100vh;
         z-index: 10;
         display: flex;
         align-items: center;
         justify-content: center;
      }

      #box-delete .box-content {
         background: white;
         width: max-content;
         height: max-content;
         margin: 0 20px;
         padding: 10px;
         border-radius: 10px;
      }
   </style>
</head>

<body>
   <div id="box-delete" class="d-none">
      <div class="box-content text-center">
         <h5>
            Are you sure you want to remove the image?
         </h5>
         <div>
            <button class="btn btn-danger mb-3 px-5 delete">
               <i class="fa fa-trash-o" aria-hidden="true"></i> Delete
            </button>
            <button class="btn btn-secondary mb-3 px-5 cancel">
               <i class="fa fa-exit" aria-hidden="true"></i> Cancel
            </button>
         </div>
      </div>
   </div>
   <section class="content container">
      <div id="box-menu">
